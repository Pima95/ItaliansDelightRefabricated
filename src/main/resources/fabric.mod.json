{
  "schemaVersion": 1,
  "id": "italiansdelight",
  "version": "${version}",
  "name": "Italian's Delight",
  "description": "Un add-on per Farmer's Delight Refabricated che aggiunge cucina, ingredienti e piatti della tradizione italiana.",
  "authors": [
    "Piergiuseppe"
  ],
  "contact": {
    "homepage": "",
    "sources": ""
  },
  "license": "MIT",
  "icon": "assets/italiansdelight/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.italiansdelight.ItaliansDelight"
    ],
    "client": [
      "dev.italiansdelight.ItaliansDelightClient"
    ],
    "jei_mod_plugin": [
      "dev.italiansdelight.integration.jei.ItaliansDelightJeiPlugin"
    ]
  },
  "mixins": [
    "italiansdelight.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "farmersdelight": "*"
  },
  "custom": {
    "italiansdelight:notes": "Dipende da Farmer's Delight Refabricated: mod id upstream 'farmersdelight', namespace risorse 'farmersdelight'."
  }
}
