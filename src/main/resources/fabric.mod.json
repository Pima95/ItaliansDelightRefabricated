{
  "schemaVersion": 1,
  "id": "italiansdelight",
  "version": "${version}",
  "name": "Italian's Delight Refabricated",
  "description": "A Farmer's Delight Refabricated add-on that expands Fabric with Italian cuisine, ingredients, farming, cheese making, and food production systems.",
  "authors": [
    "Piergiuseppe"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/italians-delight-refabricated",
    "sources": "https://github.com/Pima95/ItaliansDelightRefabricated"
  },
  "license": "Apache-2.0",
  "icon": "assets/italiansdelight/textures/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.italiansdelight.ItaliansDelight"
    ],
    "client": [
      "dev.italiansdelight.ItaliansDelightClient"
    ],
    "jei_mod_plugin": [
      "dev.italiansdelight.integration.jei.ItaliansDelightJeiPlugin"
    ]
  },
  "mixins": [
    "italiansdelight.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "farmersdelight": "*"
  },
  "custom": {
    "italiansdelight:notes": "Dipende da Farmer's Delight Refabricated: mod id upstream 'farmersdelight', namespace risorse 'farmersdelight'."
  },
  "suggests": {
    "sereneseasons": "*"
  }
}
