{
  "multipart": [
    {
      "when": {
        "axis": "z"
      },
      "apply": {
        "model": "italiansdelight:block/grape_rope_horizontal"
      }
    },
    {
      "when": {
        "axis": "x"
      },
      "apply": {
        "model": "italiansdelight:block/grape_rope_horizontal",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "tied_negative": "true"
      },
      "apply": {
        "model": "italiansdelight:block/grape_rope_tie_negative"
      }
    },
    {
      "when": {
        "axis": "z",
        "tied_positive": "true"
      },
      "apply": {
        "model": "italiansdelight:block/grape_rope_tie_positive"
      }
    },
    {
      "when": {
        "axis": "x",
        "tied_negative": "true"
      },
      "apply": {
        "model": "italiansdelight:block/grape_rope_tie_positive",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "x",
        "tied_positive": "true"
      },
      "apply": {
        "model": "italiansdelight:block/grape_rope_tie_negative",
        "y": 90
      }
    }
  ]
}
