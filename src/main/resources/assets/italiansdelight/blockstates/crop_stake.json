      },
      "apply": {
        "model": "farmersdelight:block/tomatoes_stage3"
      }
    },
    {
      "when": {
        "crop": "2",
        "crop_age": "4"
      },
      "apply": {
        "model": "farmersdelight:block/tomatoes_stage3"
      }
    },
    {
      "when": {
        "crop": "2",
        "crop_age": "5"
      },
      "apply": {
        "model": "farmersdelight:block/tomatoes_stage3"
      }
    },
    {
      "when": {
        "crop": "2",
        "crop_age": "6"
      },
      "apply": {
