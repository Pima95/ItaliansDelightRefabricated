      "apply": {
        "model": "italiansdelight:block/chili_free_stage_2"
      }
    },
    {
      "when": {
        "crop": "1",
        "crop_age": "7"
      },
      "apply": {
        "model": "italiansdelight:block/chili_free_stage_3"
      }
    },
    {
      "when": {
        "crop": "2",
        "crop_age": "0"
      },
      "apply": {
        "model": "farmersdelight:block/tomatoes_stage0"
      }
    },
    {
      "when": {
        "crop": "2",
