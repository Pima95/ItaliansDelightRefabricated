{
  "multipart": [
    {
      "apply": {
        "model": "italiansdelight:block/crop_stake"
      }
    },
    {
      "when": {
        "rope_tied": "true"
      },
      "apply": {
        "model": "italiansdelight:block/crop_stake_rope_loop"
      }
    },
    {
      "when": {
        "crop": "1",
        "crop_age": "0"
      },
      "apply": {
        "model": "italiansdelight:block/chili_free_stage_0"
      }
    },
    {
      "when": {
        "crop": "1",
        "crop_age": "1"
      },
      "apply": {
        "model": "italiansdelight:block/chili_free_stage_0"
      }
    },
    {
      "when": {
        "crop": "1",
        "crop_age": "2"
      },
      "apply": {
        "model": "italiansdelight:block/chili_free_stage_1"
      }
    },
    {
      "when": {
        "crop": "1",
        "crop_age": "3"
      },
      "apply": {
        "model": "italiansdelight:block/chili_free_stage_1"
      }
    },
    {
      "when": {
        "crop": "1",
        "crop_age": "4"
      },
      "apply": {
        "model": "italiansdelight:block/chili_free_stage_2"
      }
    },
    {
      "when": {
        "crop": "1",
        "crop_age": "5"
      },
