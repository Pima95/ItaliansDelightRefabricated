{
  "multipart": [
    {
      "apply": {
        "model": "italiansdelight:block/crop_stake"
      }
    },
    {
      "when": {
        "age": "0"
      },
      "apply": {
        "model": "italiansdelight:block/tomato_seedling_0"
      }
    },
    {
      "when": {
        "age": "1"
      },
      "apply": {
        "model": "italiansdelight:block/tomato_seedling_1"
      }
    },
    {
      "when": {
        "age": "2"
      },
      "apply": {
        "model": "farmersdelight:block/tomatoes_stage2"
      }
    },
    {
      "when": {
        "age": "3"
      },
      "apply": {
        "model": "farmersdelight:block/tomatoes_stage3"
      }
    },
    {
      "when": {
        "rope_tied": "true"
      },
      "apply": {
        "model": "italiansdelight:block/crop_stake_rope_loop"
      }
    }
  ]
}
